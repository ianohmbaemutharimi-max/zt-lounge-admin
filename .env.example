# ZT Lounge Admin — environment template.
#
# Copy to `.env.local` and fill with your Supabase project's real values.
# This file is intentionally safe to commit — it contains PLACEHOLDERS only
# and NO real credentials. Real secrets live ONLY in your local `.env.local`
# (which is gitignored and must never be committed).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Origin used by the app and by the diagnostic/audit scripts. Adjust for
# production deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (client + admin)
# ---------------------------------------------------------------------------
# Public anon key is safe to expose to browsers; still keep it out of version
# control by placing the real value in .env.local only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=env_ANON_KEY_PLACEHOLDER

# Service-role key — SERVER ONLY. Never import this into client code.
SUPABASE_SERVICE_ROLE_KEY=env_SERVICE_ROLE_KEY_PLACEHOLDER

# ---------------------------------------------------------------------------
# Public website — WhatsApp join-link number
# ---------------------------------------------------------------------------
# Country code + number, no leading "+" (e.g. 254700000000). Used by the
# public Membership Club CTA ("Join X via WhatsApp").
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# ---------------------------------------------------------------------------
# E2E Testing Credentials
# ---------------------------------------------------------------------------
# Dedicated test account credentials for end-to-end automated testing.
# These should point to a test account in your Supabase Auth system.
# NEVER use production user accounts for testing.
E2E_SUPER_ADMIN_EMAIL=e2e-super-admin@test.local
E2E_SUPER_ADMIN_PASSWORD=E2E_TEST_PASSWORD_CHANGE_ME

# ---------------------------------------------------------------------------
# Optional: local Postgres pooler password
# ---------------------------------------------------------------------------
# Used ONLY by standalone diagnostic scripts (scripts/*.mjs) that connect to
# the Supabase pooler directly. Not required by `next dev` / `next build`.
# SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Google Business Profile API OAuth — SERVER ONLY
# ---------------------------------------------------------------------------
# ⚠️ NOT the same integration as "Supabase Auth Google login" (signing users
#    into this app via Google). That provider is configured in supabase/
#    config.toml under [auth.external.google] and is unrelated to reviews.
#
# These variables power the GBP reviews integration:
#   - OAuth client: create in Google Cloud Console (type: Web application)
#   - Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly
#     (default value once deployed:
#       ${NEXT_PUBLIC_APP_URL}/api/admin/google/oauth/callback )
#   - Scope used by the app (hardcoded in lib/integrations/google-business-profile):
#       https://www.googleapis.com/auth/business.manage
#   - GBP API access must be APPROVED by Google for the Cloud project
#     (0 QPM in Cloud Console = not approved; 300 QPM = approved)
#
# SERVER-ONLY: do NOT prefix with NEXT_PUBLIC_ — the client secret must
# never reach the browser. No real values are committed anywhere.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# GBP account/location resource IDs used by the sync route for the
# reviews.list parent (accounts/{GOOGLE_ACCOUNT_ID}/locations/{GOOGLE_LOCATION_ID}).
# Obtain these from the GBP Business Profile API or the Google Business Profile
# dashboard (Location → Account/Location Resource IDs).
# Note: these are resource identifiers, not secrets — but they are committed to
# .env.local only (not .env.example) so they stay out of version control.
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=