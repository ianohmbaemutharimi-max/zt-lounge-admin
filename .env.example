# ZT Lounge Admin — environment template.
#
# Copy to `.env.local` and fill with your Supabase project's real values.
# This file is intentionally safe to commit — it contains PLACEHOLDERS only
# and NO real credentials. Real secrets live ONLY in your local `.env.local`
# (which is gitignored and must never be committed).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Origin used by the app and by the diagnostic/audit scripts. Adjust for
# production deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (client + admin)
# ---------------------------------------------------------------------------
# Public anon key is safe to expose to browsers; still keep it out of version
# control by placing the real value in .env.local only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=env_ANON_KEY_PLACEHOLDER

# Service-role key — SERVER ONLY. Never import this into client code.
SUPABASE_SERVICE_ROLE_KEY=env_SERVICE_ROLE_KEY_PLACEHOLDER

# ---------------------------------------------------------------------------
# Optional: local Postgres pooler password
# ---------------------------------------------------------------------------
# Used ONLY by standalone diagnostic scripts (scripts/*.mjs) that connect to
# the Supabase pooler directly. Not required by `next dev` / `next build`.
# SUPABASE_DB_PASSWORD=