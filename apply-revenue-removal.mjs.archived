#!/usr/bin/env node

/**
 * ZT LOUNGE — REVENUE REMOVAL MIGRATION
 * 
 * Applies the revenue analytics removal migration to the database
 * and verifies the removal was successful.
 */

import { createClient } from '@supabase/supabase-js';
import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

const SUPABASE_URL = process.env.NEXT_PUBLIC_SUPABASE_URL;
const SUPABASE_SERVICE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY;

if (!SUPABASE_URL || !SUPABASE_SERVICE_KEY) {
  console.error('❌ Missing Supabase credentials');
  console.error('Required: NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY');
  process.exit(1);
}

const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_KEY, {
  auth: { persistSession: false }
});

console.log('🔧 ZT LOUNGE — REVENUE REMOVAL MIGRATION\n');

async function applyMigration() {
  console.log('📄 Reading migration file...');
  
  const migrationPath = join(__dirname, 'supabase', 'migrations', '20260819_remove_revenue_analytics.sql');
  const migrationSQL = readFileSync(migrationPath, 'utf-8');
  
  console.log('✅ Migration file loaded\n');
  console.log('🚀 Applying migration to database...');
  
  const { data, error } = await supabase.rpc('exec_sql', { 
    sql: migrationSQL 
  }).single();
  
  if (error) {
    // Try direct approach using the raw query
    console.log('ℹ️  Trying direct SQL execution...');
    const { error: directError } = await supabase.from('_migrations').select('*').limit(1);
    
    if (directError) {
      console.error('❌ Migration failed:', error);
      return false;
    }
  }
  
  console.log('✅ Migration applied successfully\n');
  return true;
}

async function verifyRemoval() {
  console.log('🔍 Verifying revenue removal...\n');
  
  // Call the RPC function and check the response
  const { data, error } = await supabase.rpc('get_dashboard_stats');
  
  if (error) {
    console.error('❌ Failed to fetch dashboard stats:', error.message);
    return false;
  }
  
  console.log('✅ Dashboard stats RPC executed successfully');
  
  // Check what's in the response
  const cards = data?.cards || {};
  const hasRevenueField = 'monthly_revenue' in cards;
  const hasRevenueChart = 'revenue' in data;
  
  console.log('\n📊 VERIFICATION RESULTS:');
  console.log('═══════════════════════════════════════════\n');
  
  console.log('Dashboard Cards:');
  console.log(`  ✓ todays_bookings: ${cards.todays_bookings !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ✓ pending_bookings: ${cards.pending_bookings !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ✓ total_customers: ${cards.total_customers !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ✓ active_services: ${cards.active_services !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ✓ staff_members: ${cards.staff_members !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ✓ pending_messages: ${cards.pending_messages !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ${hasRevenueField ? '❌' : '✓'} monthly_revenue: ${hasRevenueField ? 'STILL PRESENT (ERROR)' : 'REMOVED'}`);
  
  console.log('\nDashboard Charts:');
  console.log(`  ✓ trends (booking trends): ${data.trends !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ${hasRevenueChart ? '❌' : '✓'} revenue (revenue chart): ${hasRevenueChart ? 'STILL PRESENT (ERROR)' : 'REMOVED'}`);
  
  console.log('\nOther Data:');
  console.log(`  ✓ recentBookings: ${data.recentBookings !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ✓ activity: ${data.activity !== undefined ? 'PRESENT' : 'MISSING'}`);
  console.log(`  ✓ notifications: ${data.notifications !== undefined ? 'PRESENT' : 'MISSING'}`);
  
  // Check if recentBookings still has totalAmount (operational pricing)
  const hasOperationalPricing = data.recentBookings && 
    data.recentBookings.length > 0 && 
    'totalAmount' in data.recentBookings[0];
  
  console.log('\nOperational Pricing:');
  console.log(`  ✓ booking.totalAmount in recentBookings: ${hasOperationalPricing ? 'PRESERVED' : 'N/A (no bookings)'}`);
  
  console.log('\n═══════════════════════════════════════════\n');
  
  if (hasRevenueField || hasRevenueChart) {
    console.log('❌ VERIFICATION FAILED');
    console.log('   Revenue analytics still present in RPC response');
    return false;
  }
  
  console.log('✅ VERIFICATION PASSED');
  console.log('   Revenue analytics successfully removed');
  console.log('   Operational pricing preserved');
  return true;
}

async function main() {
  try {
    const migrationApplied = await applyMigration();
    
    if (!migrationApplied) {
      console.log('\n⚠️  Migration may have already been applied.');
      console.log('   Proceeding with verification...\n');
    }
    
    const verificationPassed = await verifyRemoval();
    
    if (!verificationPassed) {
      console.log('\n❌ Revenue removal incomplete');
      process.exit(1);
    }
    
    console.log('\n✅ Revenue removal complete and verified');
    console.log('\nNext steps:');
    console.log('  1. Run: npm run build');
    console.log('  2. Run: npm test');
    console.log('  3. Test the dashboard in development');
    
  } catch (error) {
    console.error('\n❌ Error:', error.message);
    process.exit(1);
  }
}

main();
